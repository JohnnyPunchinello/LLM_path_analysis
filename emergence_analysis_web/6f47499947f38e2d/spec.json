{
  "phenomenon_name": "PFC bump-attractor working memory",
  "phenomenon_summary": "Stimulus-selective persistent activity in dlPFC sustained by NMDA-dependent recurrent excitation among like-tuned pyramidal neurons and broad feedback inhibition, forming a continuous bump attractor that maintains a spatial cue across the delay.",
  "units": [
    {
      "name": "spatial_cue_input",
      "role": "input",
      "scale": 0,
      "parent": null,
      "description": "Transient visuospatial cue (e.g., from posterior parietal/MD thalamus) delivering a directional input to tuned L3 pyramidal cells."
    },
    {
      "name": "dlPFC_area46",
      "role": "internal",
      "scale": 1,
      "parent": null,
      "description": "Dorsolateral PFC (principal sulcus, area 46) microcircuit hosting the bump attractor."
    },
    {
      "name": "L3_pyr_pref0",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "L3 pyramidal pool tuned to direction 0\u00b0 on the ring."
    },
    {
      "name": "L3_pyr_pref90",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "L3 pyramidal pool tuned to 90\u00b0."
    },
    {
      "name": "L3_pyr_pref180",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "L3 pyramidal pool tuned to 180\u00b0."
    },
    {
      "name": "L3_pyr_pref270",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "L3 pyramidal pool tuned to 270\u00b0."
    },
    {
      "name": "PV_basket",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "PV+ fast-spiking basket interneurons providing broad, unstructured feedback inhibition (perisomatic)."
    },
    {
      "name": "SST_interneuron",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "SST+ interneurons providing dendritic inhibition onto pyramidal cells."
    },
    {
      "name": "CB_CR_interneuron",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "Calbindin/Calretinin interneurons mediating interneuron-targeting disinhibition."
    },
    {
      "name": "L5_pyr_output",
      "role": "internal",
      "scale": 0,
      "parent": "dlPFC_area46",
      "description": "L5 pyramidal neurons reading out the L3 bump and projecting downstream."
    },
    {
      "name": "delay_persistent_activity",
      "role": "output",
      "scale": 0,
      "parent": null,
      "description": "Observed stimulus-selective delay-period persistent firing (Funahashi/Goldman-Rakic delay cells)."
    }
  ],
